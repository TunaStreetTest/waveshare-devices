{
    "type": "viewScreen",
    "id": "home",
    "style": {"bgColor": "#000000", "padding": 0},
    "layout": {"type": "none"},
    "commonProps": {"scrollable": false, "pressLock": true, "clickable": true},
    "children": [
        {
            "type": "canvas",
            "id": "nav_next",
            "placement": {"mode": "absolute", "x": 184, "y": 206, "width": 184, "height": 174},
            "layout": {"type": "none"},
            "style": {"bgColor": "#000000"},
            "commonProps": {"scrollable": false, "pressLock": true, "clickable": true},
            "events": [
                {"type": "pressed", "effects": [{"type": "emitAction", "action": "demo.next"}]},
                {"type": "released", "effects": [{"type": "emitAction", "action": "demo.next"}]}
            ]
        },
        {
            "type": "image",
            "id": "art_undeclared",
            "placement": {"mode": "absolute", "x": 0, "y": 206, "width": 368, "height": 168},
            "layout": {"type": "none"},
            "imageProps": {"src": "${image.launch}", "innerAlign": "contain"}
        },
        {
            "type": "image",
            "id": "art_declared",
            "placement": {"mode": "absolute", "x": 0, "y": 20, "width": 368, "height": 120},
            "layout": {"type": "none"},
            "commonProps": {"clickable": false},
            "imageProps": {"src": "${image.launch}", "innerAlign": "contain"}
        }
    ]
}
